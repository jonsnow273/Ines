# Sephora Environment Variables
# Copy this file to .env and fill in your values

# HuggingFace token (needed to download gated models like Mistral)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Device to run models on: cuda, cpu, or mps (Apple Silicon)
SEPHORA_DEVICE=cuda

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Steering dashboard server settings
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

